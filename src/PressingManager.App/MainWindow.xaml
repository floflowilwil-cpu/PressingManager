
<Window x:Class="PressingManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pressing Manager"
        Height="720"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#F3F7FF">

    <!-- RESSOURCES ET STYLES -->
    <Window.Resources>

        <!-- STYLE DU BOUTON PRINCIPAL -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0864D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#064DA8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#043B82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE DES CHAMPS DE SAISIE -->
        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Height" Value="55"/>
            <Setter Property="BorderBrush" Value="#C9DCFA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,22"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#08A6B5"/>
                    <Setter Property="Background" Value="#F0FCFF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- STRUCTURE PRINCIPALE -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55*"/>
            <ColumnDefinition Width="45*"/>
        </Grid.ColumnDefinitions>

        <!-- PANNEAU GAUCHE : PHOTO DU PRESSING -->
        <Grid Grid.Column="0">
            <Image Source="/PressingManager.App;component/Resources/Images/PressingManager_FondGauche.png"
                   Stretch="UniformToFill"/>
        </Grid>

        <!-- PANNEAU DROIT : CONNEXION -->
        <Grid Grid.Column="1" Background="#F3F7FF">

            <Grid Margin="25,15">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BOUTONS DE LANGUE -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,5,10,15">

                    <Button x:Name="btnFrench"
                            Content="FR"
                            Click="BtnFrench_Click"
                            Width="62"
                            Height="42"
                            Background="#0864D9"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button x:Name="btnEnglish"
                            Content="EN"
                            Click="BtnEnglish_Click"
                            Width="62"
                            Height="42"
                            Background="Transparent"
                            Foreground="#174A91"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Margin="10,0,0,0"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- CONTENU CENTRAL -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Width="430"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,15,0,25">

                        <!-- TITRE -->
                        <TextBlock x:Name="txtWelcome"
                                   Text="Bienvenue !"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="#123D7A"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="txtSubtitle"
                                   Text="{Binding Subtitle}"
                                   FontSize="16"
                                   Foreground="#174A91"
                                   Margin="0,10,0,25"
                                   TextWrapping="Wrap"/>

                        <!-- CARTE DE CONNEXION -->
                        <Border Background="White"
                                CornerRadius="22"
                                Padding="24">

                            <StackPanel>

                                <!-- NOM COMPLET : PREMIÈRE UTILISATION -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSetupMode}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Nom complet"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#123D7A"
                                               Margin="0,0,0,10"/>

                                    <Border Style="{StaticResource InputBorder}">
                                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="12"
                                                 FontSize="15"
                                                 VerticalContentAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- NOM UTILISATEUR -->
                                <TextBlock x:Name="txtUsernameLabel"
                                           Text="Nom d'utilisateur"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#123D7A"
                                           Margin="0,0,0,10"/>

                                <Border Style="{StaticResource InputBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE77B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="#0864D9"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <TextBox x:Name="txtUsername"
                                                 Grid.Column="1"
                                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="8"
                                                 FontSize="15"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- MOT DE PASSE -->
                                <TextBlock x:Name="txtPasswordLabel"
                                           Text="Mot de passe"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#123D7A"
                                           Margin="0,0,0,10"/>

                                <Border Style="{StaticResource InputBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="#0864D9"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <PasswordBox x:Name="txtPassword"
                                                     Grid.Column="1"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="8"
                                                     FontSize="15"
                                                     VerticalContentAlignment="Center"
                                                     PasswordChanged="TxtPassword_PasswordChanged"/>

                                        <TextBox x:Name="txtPasswordVisible"
                                                 Grid.Column="1"
                                                 Visibility="Collapsed"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="8"
                                                 FontSize="15"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="TxtPasswordVisible_TextChanged"/>

                                        <Button x:Name="btnTogglePassword"
                                                Grid.Column="2"
                                                Content="&#xE890;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="18"
                                                Foreground="#0864D9"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Afficher le mot de passe"
                                                Click="BtnTogglePassword_Click"/>
                                    </Grid>
                                </Border>

                                <!-- CONFIRMATION DU MOT DE PASSE -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSetupMode}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Confirmer le mot de passe"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#123D7A"
                                               Margin="0,0,0,10"/>

                                    <Border Style="{StaticResource InputBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="42"/>
                                            </Grid.ColumnDefinitions>

                                            <PasswordBox x:Name="txtConfirmPassword"
                                                         Grid.Column="0"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="8"
                                                         FontSize="15"
                                                         VerticalContentAlignment="Center"
                                                         PasswordChanged="TxtConfirmPassword_PasswordChanged"/>

                                            <TextBox x:Name="txtConfirmPasswordVisible"
                                                     Grid.Column="0"
                                                     Visibility="Collapsed"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="8"
                                                     FontSize="15"
                                                     VerticalContentAlignment="Center"
                                                     TextChanged="TxtConfirmPasswordVisible_TextChanged"/>

                                            <Button x:Name="btnToggleConfirmPassword"
                                                    Grid.Column="1"
                                                    Content="&#xE890;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="18"
                                                    Foreground="#0864D9"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Afficher le mot de passe"
                                                    Click="BtnToggleConfirmPassword_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- MESSAGE D'ERREUR -->
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#D93025"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,15"/>

                                <!-- SE SOUVENIR DE MOI -->
                                <CheckBox x:Name="chkRemember"
                                          Content="Se souvenir de moi"
                                          FontSize="15"
                                          Foreground="#174A91"
                                          Margin="0,0,0,22"/>

                                <!-- BOUTON CONNEXION -->
                                <Button x:Name="btnLogin"
                                        Content="{Binding SubmitLabel}"
                                        Height="58"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="BtnLogin_Click"/>

                                <!-- MOT DE PASSE OUBLIÉ -->
                                <TextBlock x:Name="txtForgotPassword"
                                           Text="Mot de passe oublié ?"
                                           Foreground="#0864D9"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,22,0,0"
                                           Cursor="Hand"/>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PIED DE PAGE -->
                <TextBlock Grid.Row="2"
                           Text="© 2026 Pressing Manager. Tous droits réservés."
                           Foreground="#174A91"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,12,0,5"/>

            </Grid>
        </Grid>
    </Grid>
</Window>
