<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        THEME COMMUN PRESSING MANAGER
        Modele : l'onglet Statistiques. Palette : marine #0F2A4A / #12365D, bleu #0864D9, turquoise #08A6B5.
        Tout ce qui est ici s'applique automatiquement a TOUS les ecrans (styles implicites) :
        barres de defilement fines et arrondies, champs, listes deroulantes, tableaux, boutons.
        Boutons : Style="{StaticResource BtnPrimary}" (bleu), BtnLight (blanc), BtnDanger (rouge).
    -->

    <!-- ===================== COULEURS ===================== -->
    <Color x:Key="NavyColor">#0F2A4A</Color>
    <SolidColorBrush x:Key="NavyBrush" Color="#0F2A4A" />
    <SolidColorBrush x:Key="InkBrush" Color="#12365D" />
    <SolidColorBrush x:Key="BlueBrush" Color="#0864D9" />
    <SolidColorBrush x:Key="TealBrush" Color="#08A6B5" />
    <SolidColorBrush x:Key="IconTealBrush" Color="#14B8A6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#718096" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="PageBrush" Color="#F3F6FB" />

    <!-- ===================== ICONES (grille 24 x 24, trait 2) ===================== -->
