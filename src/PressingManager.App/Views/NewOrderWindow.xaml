<Window x:Class="PressingManager.App.Views.NewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PressingManager.App.Localization"
        Title="{loc:T Ord_Dlg_Title}"
        Width="860"
        Height="720"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FB">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tete -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="10" Background="#0F2A4A" Margin="0,0,12,0">
                <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="#14B8A6" StrokeThickness="2" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{StaticResource IconOrders}" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:T Ord_Dlg_Title}" FontSize="21" FontWeight="Bold" Foreground="#0F2A4A" />
                <TextBlock Text="{loc:T Ord_Dlg_Subtitle}" FontSize="12" Foreground="#64748B" />
            </StackPanel>
        </StackPanel>

        <!-- Corps -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Carte 1 : Client -->
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right"
                                    Content="{loc:T Ord_Dlg_QuickCustomerBtn}"
                                    Command="{Binding ToggleQuickCustomerCommand}"
                                    Style="{StaticResource BtnLight}"
                                    MinHeight="32"
                                    Padding="12,5"
                                    FontSize="12"
                                    Visibility="{Binding CanManageCustomers, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{loc:T Ord_Dlg_CustomerSection}"
                                       FontWeight="Bold"
                                       Foreground="#0F8F91"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="{loc:T Ord_Dlg_SelectCustomer}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayLabel" />

                        <!-- Edition directe de l'e-mail du client selectionne -->
                        <Grid Margin="0,10,0,0" Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Ord_Dlg_SelectedEmail}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedCustomerEmail, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="{loc:T Ord_Dlg_SaveEmailBtn}"
                                    Command="{Binding SaveSelectedCustomerEmailCommand}"
                                    Style="{StaticResource BtnLight}"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding CanManageCustomers, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <TextBlock Text="{loc:T Ord_Dlg_NoCustomers}"
                                   Foreground="#D97706"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasNoCustomers, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Creation rapide de client -->
                        <Border Background="#F8FAFC"
                                BorderBrush="#DCE6EF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,12,0,0"
                                Visibility="{Binding IsQuickCustomerVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="{loc:T Ord_Dlg_QuickName}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="{loc:T Ord_Dlg_QuickPhone}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="{loc:T Ord_QuickEmail}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding QuickCustomerEmail, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Content="{loc:T Ord_Dlg_QuickCreateBtn}"
                                        Command="{Binding CreateQuickCustomerCommand}"
                                        Style="{StaticResource BtnPrimary}"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Carte 2 : Articles & prestations -->
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:T Ord_Dlg_ItemsSection}"
                                   FontWeight="Bold"
                                   Foreground="#0F8F91"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{loc:T Ord_Err_NoServices}"
                                   Foreground="#C0392B"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasNoServices, Converter={StaticResource BoolToVisibility}}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{loc:T Ord_Dlg_Service}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Services}"
                                          SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayLabel" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{loc:T Ord_Dlg_ItemType}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ItemTypeText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="{loc:T Ord_Dlg_Qty}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="{loc:T Ord_Dlg_UnitPrice}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Button Grid.Column="4"
                                    Content="{loc:T Ord_Dlg_AddItemBtn}"
                                    Command="{Binding AddItemCommand}"
                                    Background="#08A6B5"
                                    Style="{StaticResource BtnPrimary}"
                                    VerticalAlignment="Bottom" />
                        </Grid>

                        <TextBlock Text="{loc:T Ord_Dlg_Observations}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ObservationsText, UpdateSourceTrigger=PropertyChanged}" />

                        <DataGrid ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  MinHeight="130"
                                  MaxHeight="200"
                                  Margin="0,12,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Ord_Dlg_ColService}" Binding="{Binding ServiceName}" Width="140" />
                                <DataGridTextColumn Header="{loc:T Ord_Dlg_ColItem}" Binding="{Binding ItemType}" Width="*" />
                                <DataGridTextColumn Header="{loc:T Ord_Dlg_ColQty}" Binding="{Binding Quantity}" Width="60" />
                                <DataGridTextColumn Header="{loc:T Ord_Dlg_ColPrice}" Binding="{Binding UnitPriceText}" Width="115" />
                                <DataGridTextColumn Header="{loc:T Ord_Dlg_ColLineTotal}" Binding="{Binding LineTotalText}" Width="125" />
                                <DataGridTemplateColumn Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:T Ord_Dlg_RemoveItemBtn}"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnDanger}"
                                                    MinHeight="28"
                                                    Padding="10,4"
                                                    FontSize="12" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Carte 3 : Retrait, remise et frais -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Ord_Dlg_OptionsSection}"
                                   FontWeight="Bold"
                                   Foreground="#0F8F91"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Ord_Dlg_ExpectedDate}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding ExpectedDate, Mode=TwoWay}"
                                            MinHeight="38"
                                            VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Ord_Dlg_Discount}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Ord_Dlg_Fees}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FeesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{loc:T Ord_Dlg_Notes}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding CanRegisterPayment, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:T Ord_Dlg_PaymentMethod}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PaymentMethods}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                                      Width="280"
                                      HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Pied fixe : Total + Boutons d'action -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T Ord_Dlg_Subtotal}" Foreground="#64748B" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SubtotalText}" Foreground="#12365D" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{loc:T Ord_Dlg_Total}" Foreground="#0F2A4A" FontWeight="Bold" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding TotalText}" Foreground="#10B981" FontWeight="Bold" FontSize="18" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:T Ord_Dlg_CancelBtn}"
                                IsCancel="True"
                                Click="CancelButton_Click"
                                Style="{StaticResource BtnLight}"
                                Margin="0,0,10,0" />

                        <Button Content="{loc:T Ord_Dlg_CreateBtn}"
                                Command="{Binding CreateOrderCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource BtnPrimary}"
                                Margin="0,0,10,0" />

                        <Button Content="{loc:T Ord_Dlg_CreateAndPayBtn}"
                                Command="{Binding CreateAndPayCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Background="#10B981"
                                Style="{StaticResource BtnPrimary}"
                                Visibility="{Binding CanRegisterPayment, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Message}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           FontSize="13"
                           FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E8449" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#C0392B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
