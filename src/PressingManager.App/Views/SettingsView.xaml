<UserControl x:Class="PressingManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PressingManager.App.Localization"
             Background="#F3F6FB">
    <UserControl.Resources>

        <!-- Puces de choix (meme modele que les periodes de Statistiques) -->
        <Style x:Key="ChoiceChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="White" CornerRadius="8" Padding="18,9"
                                BorderBrush="#D8E1EC" BorderThickness="1">
                            <ContentPresenter x:Name="Text" TextElement.Foreground="#12365D"
                                              TextElement.FontWeight="SemiBold" TextElement.FontSize="13" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#0864D9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#0864D9" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#0864D9" />
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#718096" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,3" />
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#12365D" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">

            <!-- EN-TETE : meme modele que Statistiques (pastille marine + pictogramme turquoise) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,22">
                <Border Width="38" Height="38" CornerRadius="10" Background="#0F2A4A" Margin="0,0,12,0">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#14B8A6" StrokeThickness="2" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{StaticResource IconSettings}" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_Title}" FontSize="22" FontWeight="Bold" Foreground="#0F2A4A" />
                    <TextBlock Text="{loc:T Settings_Subtitle}" FontSize="12" Foreground="#64748B" />
                </StackPanel>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- COLONNE GAUCHE -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">

                    <!-- Mon compte -->
                    <Border Background="White" CornerRadius="10" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="34" Height="34" CornerRadius="9" Background="#E3EEFF" Margin="0,0,12,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="#0864D9" StrokeThickness="2.2" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="{StaticResource IconUsers}" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{loc:T Settings_Account}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{loc:T Settings_FullName}" Style="{StaticResource InfoLabel}" />
                            <TextBlock x:Name="TxtFullName" Text="—" Style="{StaticResource InfoValue}" />

                            <TextBlock Text="{loc:T Settings_Username}" Style="{StaticResource InfoLabel}" />
                            <TextBlock x:Name="TxtUsername" Text="—" Style="{StaticResource InfoValue}" />

                            <TextBlock Text="{loc:T Settings_Role}" Style="{StaticResource InfoLabel}" />
                            <TextBlock x:Name="TxtRole" Text="—" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                    </Border>

                    <!-- Langue -->
                    <Border Background="White" CornerRadius="10" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="34" Height="34" CornerRadius="9" Background="#DDF3F5" Margin="0,0,12,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="#08A6B5" StrokeThickness="2.2" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="{StaticResource IconGlobe}" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{loc:T Settings_Language}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{loc:T Settings_LanguageHint}" Foreground="#718096" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,6,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ChipFrench" GroupName="SettingsLanguage" Content="{loc:T Settings_French}"
                                             Style="{StaticResource ChoiceChip}" Click="ChipFrench_Click" />
                                <RadioButton x:Name="ChipEnglish" GroupName="SettingsLanguage" Content="{loc:T Settings_English}"
                                             Style="{StaticResource ChoiceChip}" Click="ChipEnglish_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- COLONNE DROITE -->
                <StackPanel Grid.Column="1">

                    <!-- Mot de passe -->
                    <Border Background="White" CornerRadius="10" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="34" Height="34" CornerRadius="9" Background="#FDE6E0" Margin="0,0,12,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="#D9534F" StrokeThickness="2.2" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M5,11 L19,11 L19,21 L5,21 Z M8,11 L8,7 C8,4.8 9.8,3 12,3 C14.2,3 16,4.8 16,7 L16,11" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{loc:T Settings_Password}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{loc:T Settings_CurrentPassword}" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="CurrentPasswordBox" />

                            <TextBlock Text="{loc:T Settings_NewPassword}" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="NewPasswordBox" />

                            <TextBlock Text="{loc:T Settings_ConfirmPassword}" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="ConfirmPasswordBox" />

                            <Button Content="{loc:T Settings_ChangePassword}" Style="{StaticResource BtnPrimary}"
                                    Margin="0,18,0,0" HorizontalAlignment="Left" Click="BtnChangePassword_Click" />

                            <TextBlock x:Name="TxtPasswordMessage" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Session + a propos -->
                    <Border Background="White" CornerRadius="10" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="34" Height="34" CornerRadius="9" Background="#DDF5EC" Margin="0,0,12,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="#16845B" StrokeThickness="2.2" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="{StaticResource IconLogout}" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{loc:T Settings_Session}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{loc:T Settings_SessionHint}" Foreground="#718096" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,6,0,14" />
                            <Button Content="{loc:T Settings_Logout}" Style="{StaticResource BtnDanger}"
                                    HorizontalAlignment="Left" Click="BtnLogout_Click" />
                            <TextBlock x:Name="TxtVersion" Margin="0,18,0,0" Foreground="#A0AEC0" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- PASSERELLES : E-MAIL SMTP & MOBILE MONEY -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Notifications E-mail (SMTP) -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="22" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Settings_Smtp_Title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{loc:T Settings_Smtp_Subtitle}" Foreground="#718096" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,12" />

                        <CheckBox x:Name="ChkSmtpEnabled" Content="{loc:T Settings_Smtp_Enabled}" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Settings_Smtp_Host}" Style="{StaticResource InfoLabel}" />
                                <TextBox x:Name="TxtSmtpHost" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:T Settings_Smtp_Port}" Style="{StaticResource InfoLabel}" />
                                <TextBox x:Name="TxtSmtpPort" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkSmtpSsl" Content="{loc:T Settings_Smtp_Ssl}" Margin="0,10,0,0" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Settings_Smtp_Username}" Style="{StaticResource InfoLabel}" />
                                <TextBox x:Name="TxtSmtpUsername" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:T Settings_Smtp_Password}" Style="{StaticResource InfoLabel}" />
                                <PasswordBox x:Name="TxtSmtpPassword" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Settings_Smtp_FromAddress}" Style="{StaticResource InfoLabel}" />
                                <TextBox x:Name="TxtSmtpFromAddress" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:T Settings_Smtp_FromName}" Style="{StaticResource InfoLabel}" />
                                <TextBox x:Name="TxtSmtpFromName" />
                            </StackPanel>
                        </Grid>

                        <Button Content="{loc:T Settings_Smtp_SaveBtn}" Style="{StaticResource BtnPrimary}"
                                Margin="0,16,0,0" HorizontalAlignment="Left" Click="BtnSaveSmtp_Click" />

                        <Separator Margin="0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Settings_Smtp_TestEmail}" Style="{StaticResource InfoLabel}" Margin="0,0,0,3" />
                                <TextBox x:Name="TxtSmtpTestEmail" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:T Settings_Smtp_TestBtn}" Style="{StaticResource BtnLight}"
                                    VerticalAlignment="Bottom" Click="BtnTestSmtp_Click" />
                        </Grid>

                        <TextBlock x:Name="TxtSmtpMessage" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- Passerelle Mobile Money (MTN / Orange - Campay) -->
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="22" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:T Settings_Momo_Title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{loc:T Settings_Momo_Subtitle}" Foreground="#718096" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="ChipMomoSimulation" GroupName="MomoProvider"
                                         Content="{loc:T Settings_Momo_ModeSim}"
                                         Style="{StaticResource ChoiceChip}" />
                            <RadioButton x:Name="ChipMomoCampay" GroupName="MomoProvider"
                                         Content="{loc:T Settings_Momo_ModeCampay}"
                                         Style="{StaticResource ChoiceChip}" />
                        </StackPanel>

                        <TextBlock Text="{loc:T Settings_Momo_BaseUrl}" Style="{StaticResource InfoLabel}" />
                        <TextBox x:Name="TxtMomoBaseUrl" />

                        <TextBlock Text="{loc:T Settings_Momo_ApiToken}" Style="{StaticResource InfoLabel}" />
                        <TextBox x:Name="TxtMomoApiToken" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Settings_Momo_Username}" Style="{StaticResource InfoLabel}" />
                                <TextBox x:Name="TxtMomoUsername" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:T Settings_Momo_Password}" Style="{StaticResource InfoLabel}" />
                                <PasswordBox x:Name="TxtMomoPassword" />
                            </StackPanel>
                        </Grid>

                        <Button Content="{loc:T Settings_Momo_SaveBtn}" Style="{StaticResource BtnPrimary}"
                                Margin="0,16,0,0" HorizontalAlignment="Left" Click="BtnSaveMomo_Click" />

                        <TextBlock x:Name="TxtMomoMessage" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
