<Window x:Class="PressingManager.App.Views.CustomerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">

    <StackPanel Margin="28,24,28,24">
        <TextBlock x:Name="TitleText" Text="Nouveau client" FontSize="20" FontWeight="Bold" Foreground="#12365D"/>

        <TextBlock Text="Nom complet *" Style="{StaticResource PmLabel}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource PmInput}" MaxLength="150"/>

        <TextBlock Text="Téléphone *" Style="{StaticResource PmLabel}"/>
        <TextBox x:Name="PhoneBox" Style="{StaticResource PmInput}" MaxLength="30"/>

        <TextBlock Text="Adresse" Style="{StaticResource PmLabel}"/>
        <TextBox x:Name="AddressBox" Style="{StaticResource PmInput}" MaxLength="300"/>

        <TextBlock Text="Notes" Style="{StaticResource PmLabel}"/>
        <TextBox x:Name="NotesBox" Style="{StaticResource PmInput}" MaxLength="1000"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalScrollBarVisibility="Auto"/>

        <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"
                   Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Annuler" Style="{StaticResource PmSecondaryButton}" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="Enregistrer" Style="{StaticResource PmPrimaryButton}"
                    IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
