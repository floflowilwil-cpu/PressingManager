<Window x:Class="PressingManager.App.Views.PaymentReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:PressingManager.Core.Enums;assembly=PressingManager.Core"
        xmlns:loc="clr-namespace:PressingManager.App.Localization"
        Title="{loc:T Receipt_WindowTitle}"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
        <StackPanel Margin="20">

            <!-- Zone imprimable (Confirmation visuelle + Ticket de recu officiel) -->
            <Border x:Name="ReceiptVisual"
                    Background="White"
                    CornerRadius="14"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#0F2A4A" Opacity="0.08" BlurRadius="18" ShadowDepth="4" />
                </Border.Effect>

                <StackPanel>
                    <!-- En-tete Navy Pressing Manager + Logo vectoriel -->
                    <Border Background="#0F2A4A" CornerRadius="14,14,0,0" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icone vectorielle cintre / pressing -->
                            <Border Width="40" Height="40" CornerRadius="10" Background="#1E3A5F" VerticalAlignment="Center">
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#14B8A6" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M12,6 C12,4.5 13.5,3.5 14.5,4.5 C15.2,5.2 14.8,6.5 13.5,7.2 L12,8 L3,14.5 C2.2,15 2.5,16.5 3.5,16.5 L20.5,16.5 C21.5,16.5 21.8,15 21,14.5 L12,8" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PRESSING MANAGER" Foreground="White" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="{loc:T Receipt_OfficialHeader}" Foreground="#5EEAD4" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="#14B8A6" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ReceiptNumber}" Foreground="White" FontWeight="Bold" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Illustration vectorielle stylée de validation du paiement -->
                    <Border Background="#F0FDF4" Padding="20,18" BorderBrush="#DCFCE7" BorderThickness="0,0,0,1">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="92" Height="92" HorizontalAlignment="Center">
                                <!-- Halo externe -->
                                <Ellipse Width="92" Height="92" Fill="#DCFCE7" />
                                <!-- Halo intermediaire -->
                                <Ellipse Width="74" Height="74" Fill="#A7F3D0" />
                                <!-- Cercle principal validation -->
                                <Ellipse Width="58" Height="58" Fill="#10B981">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#10B981" Opacity="0.35" BlurRadius="12" ShadowDepth="3" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <!-- Coche blanche vectorielle -->
                                <Viewbox Width="30" Height="30">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="White" StrokeThickness="3.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M4.5,12.5 L9.5,17.5 L19.5,6.5" />
                                    </Canvas>
                                </Viewbox>
                                <!-- Etoiles decoratives vectorielles -->
                                <Path Fill="#14B8A6" Width="10" Height="10" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                      Data="M5,0 L6.3,3.7 L10,5 L6.3,6.3 L5,10 L3.7,6.3 L0,5 L3.7,3.7 Z" />
                                <Path Fill="#F59E0B" Width="8" Height="8" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,8"
                                      Data="M5,0 L6.3,3.7 L10,5 L6.3,6.3 L5,10 L3.7,6.3 L0,5 L3.7,3.7 Z" />
                            </Grid>

                            <TextBlock Text="{loc:T Receipt_SuccessTitle}"
                                       FontSize="18" FontWeight="Bold" Foreground="#065F46"
                                       HorizontalAlignment="Center" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding RecordedOnText}"
                                       HorizontalAlignment="Center" Foreground="#047857" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Details du recu -->
                    <StackPanel Margin="22,18,22,16">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="{loc:T Receipt_LabelClient}" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding CustomerName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F2A4A" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="{loc:T Receipt_LabelOrder}" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding OrderNumber}" FontSize="13" FontWeight="SemiBold" Foreground="#0F2A4A" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="{loc:T Receipt_LabelMethod}" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,4" Margin="0,4,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E0F2FE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static enums:PaymentMethod.Cash}">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static enums:PaymentMethod.MtnMobileMoney}">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static enums:PaymentMethod.OrangeMoney}">
                                                    <Setter Property="Background" Value="#FFEDD5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding MethodLabel}" FontSize="12" FontWeight="Bold" Foreground="#0F2A4A" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="{loc:T Receipt_LabelCashier}" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding CashierName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F2A4A" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                        Visibility="{Binding HasReference, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:T Receipt_LabelReference}" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding Reference}" FontSize="13" FontWeight="SemiBold" Foreground="#0F2A4A" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Encadre Montants -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{loc:T Receipt_OrderTotal}" Foreground="#475569" FontSize="12" />
                                    <TextBlock Text="{Binding OrderTotal, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" Foreground="#0F2A4A" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{loc:T Receipt_AmountPaid}" Foreground="#065F46" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AmountPaid, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" Foreground="#10B981" FontWeight="Bold" FontSize="18" />
                                </Grid>
                                <Separator Background="#E2E8F0" Margin="0,2,0,8" />
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{loc:T Receipt_TotalPaid}" Foreground="#475569" FontSize="12" />
                                    <TextBlock Text="{Binding TotalPaidOnOrder, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" Foreground="#0F2A4A" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="{loc:T Receipt_RemainingBalance}" Foreground="#475569" FontSize="12" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding RemainingBalance, StringFormat='{}{0:N2}'}" Foreground="#0F2A4A" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Border CornerRadius="5" Padding="8,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFullyPaid}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#92400E" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFullyPaid}" Value="True">
                                                                <Setter Property="Foreground" Value="#166534" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Separateur en pointilles facon ticket -->
                        <Rectangle Height="1" Margin="0,16,0,12" Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="4,3" />

                        <!-- Code-barres vectoriel decoratif + pied de ticket -->
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="28">
                                <Rectangle Width="3" Fill="#0F2A4A" Margin="1,0" />
                                <Rectangle Width="1" Fill="#0F2A4A" Margin="1,0" />
                                <Rectangle Width="4" Fill="#0F2A4A" Margin="2,0" />
                                <Rectangle Width="2" Fill="#0F2A4A" Margin="1,0" />
                                <Rectangle Width="1" Fill="#0F2A4A" Margin="2,0" />
                                <Rectangle Width="3" Fill="#0F2A4A" Margin="1,0" />
                                <Rectangle Width="5" Fill="#0F2A4A" Margin="2,0" />
                                <Rectangle Width="2" Fill="#0F2A4A" Margin="1,0" />
                                <Rectangle Width="1" Fill="#0F2A4A" Margin="1,0" />
                                <Rectangle Width="3" Fill="#0F2A4A" Margin="2,0" />
                                <Rectangle Width="2" Fill="#0F2A4A" Margin="1,0" />
                                <Rectangle Width="4" Fill="#0F2A4A" Margin="2,0" />
                                <Rectangle Width="1" Fill="#0F2A4A" Margin="1,0" />
                                <Rectangle Width="3" Fill="#0F2A4A" Margin="1,0" />
                                <Rectangle Width="2" Fill="#0F2A4A" Margin="2,0" />
                                <Rectangle Width="1" Fill="#0F2A4A" Margin="1,0" />
                                <Rectangle Width="3" Fill="#0F2A4A" Margin="1,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding ReceiptNumber}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,2" />
                            <TextBlock Text="{loc:T Receipt_Thanks}" FontSize="11" FontWeight="SemiBold" Foreground="#14B8A6" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Boutons d'action (hors zone d'impression) -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Background="#0F2A4A" Style="{StaticResource RoundedButton}" Margin="0,0,8,0"
                        Click="SavePdfButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,17 L4,20 L20,20 L20,17" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{loc:T Receipt_DownloadPdf}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Background="#0864D9" Style="{StaticResource RoundedButton}" Margin="0,0,8,0"
                        Click="PrintButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="White" StrokeThickness="2" StrokeLineJoin="Round"
                                      Data="M6,9 L6,3 L18,3 L18,9 M6,18 L4,18 C2.9,18 2,17.1 2,16 L2,11 C2,9.9 2.9,9 4,9 L20,9 C21.1,9 22,9.9 22,11 L22,16 C22,17.1 21.1,18 20,18 L18,18 M6,14 L18,14 L18,21 L6,21 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{loc:T Receipt_Print}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Background="#14B8A6" Style="{StaticResource RoundedButton}" Margin="0,0,8,0"
                        Click="SaveTextButton_Click">
                    <TextBlock Text="{loc:T Receipt_ExportTxt}" VerticalAlignment="Center" FontSize="12" />
                </Button>

                <Button Grid.Column="3" Content="{loc:T Receipt_Close}" Background="#64748B" Style="{StaticResource RoundedButton}"
                        Click="CloseButton_Click" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
