
<Window x:Class="PressingManager.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pressing Manager - Tableau de bord"
        Height="760"
        Width="1280"
        MinHeight="650"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FC">

    <Window.Resources>

        <!-- Couleurs principales -->
        <SolidColorBrush x:Key="Navy" Color="#102B46"/>
        <SolidColorBrush x:Key="Turquoise" Color="#08A6B5"/>
        <SolidColorBrush x:Key="TextDark" Color="#18344F"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8493A5"/>

        <!-- Boutons du menu -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C3D0DE"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="17,13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="12,0,12,6"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1C4261"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#087F91"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton actif -->
        <Style x:Key="ActiveSidebarButton"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#087F91"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Cartes statistiques -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border Grid.Column="0" Background="{StaticResource Navy}">
            <DockPanel LastChildFill="True">

                <!-- IDENTITE DE L'APPLICATION -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="23,28,20,38">

                    <Border Width="48"
                            Height="48"
                            CornerRadius="12"
                            Background="#087F91"
                            HorizontalAlignment="Left">
                        <TextBlock Text="PM"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Pressing Manager"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,14,0,3"/>

                    <TextBlock Text="GESTION PROFESSIONNELLE"
           Foreground="#08A6B5"
           FontSize="10"
           FontWeight="SemiBold"/>
                </StackPanel>

                <!-- PIED DU MENU -->
                <StackPanel DockPanel.Dock="Bottom"
                            Margin="20,15,20,22">

                    <Separator Background="#34516B"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Pressing Manager"
                               Foreground="#D6E1EF"
                               FontSize="12"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="© 2026 Tous droits réservés"
                               Foreground="#8196AB"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- NAVIGATION -->
                <StackPanel>
                    <TextBlock Text="MENU PRINCIPAL"
                               Foreground="#8196AB"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="24,0,0,14"/>

                    <Button x:Name="BtnDashboard"
                            Style="{StaticResource ActiveSidebarButton}"
                            Click="BtnDashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="32"/>
                            <TextBlock Text="Tableau de bord"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="32"/>
                            <TextBlock Text="Clients"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="32"/>
                            <TextBlock Text="Commandes"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="32"/>
                            <TextBlock Text="Vêtements"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPayments"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnPayments_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="32"/>
                            <TextBlock Text="Paiements"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStatistics"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnStatistics_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="32"/>
                            <TextBlock Text="Statistiques"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="32"/>
                            <TextBlock Text="Utilisateurs"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <Grid x:Name="DashboardHomeContent"
              Grid.Column="1"
              Margin="32,27,32,28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- EN-TETE -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Bonjour et bienvenue !"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDark}"/>

                    <TextBlock Text="Voici un aperçu de l'activité de votre pressing."
                               FontSize="13"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>

            <!-- STATISTIQUES -->
            <StackPanel Grid.Row="1">

                <TextBlock Text="Vue d'ensemble"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextDark}"
                           Margin="0,0,0,17"/>

                <UniformGrid Columns="4" Margin="0,0,0,27">

                    <!-- CLIENTS -->
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="CLIENTS"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock Text="—"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#18344F"
                                       Margin="0,12,0,4"/>

                            <TextBlock Text="Total des clients"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- COMMANDES -->
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="COMMANDES"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock Text="—"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#0864D9"
                                       Margin="0,12,0,4"/>

                            <TextBlock Text="Total des commandes"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- EN COURS -->
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="EN COURS"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock Text="—"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#08A6B5"
                                       Margin="0,12,0,4"/>

                            <TextBlock Text="Commandes en traitement"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- REVENUS -->
                    <Border Style="{StaticResource StatCard}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="REVENUS"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock Text="—"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#16845B"
                                       Margin="0,12,0,4"/>

                            <TextBlock Text="Revenus enregistrés"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>
            </StackPanel>

            <!-- ZONES D'ACTIVITE -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ACTIVITES RECENTES -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="13"
                        Padding="23"
                        Margin="0,0,14,0">

                    <StackPanel>
                        <TextBlock Text="Activités récentes"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDark}"/>

                        <TextBlock Text="Suivez les dernières opérations effectuées."
                                   FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,6,0,22"/>

                        <Separator Background="#E9EEF4"/>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,35,0,0">

                            <TextBlock Text="&#xE823;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="34"
                                       Foreground="#AAB9C9"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Aucune activité récente"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#718096"
                                       HorizontalAlignment="Center"
                                       Margin="0,13,0,5"/>

                            <TextBlock Text="Les dernières opérations apparaîtront ici."
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SUIVI DE L'ACTIVITE -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="13"
                        Padding="22">

                    <StackPanel>
                        <TextBlock Text="Suivi des commandes"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDark}"/>

                        <TextBlock Text="État général du traitement"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,6,0,22"/>

                        <Border Background="#F3F7FC"
                                CornerRadius="9"
                                Padding="13"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="En attente"
                                           FontSize="12"
                                           Foreground="#718096"/>
                                <TextBlock Text="— commande(s)"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#18344F"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#EFFBFC"
                                CornerRadius="9"
                                Padding="13"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="En traitement"
                                           FontSize="12"
                                           Foreground="#718096"/>
                                <TextBlock Text="— commande(s)"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#087F91"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#EFF8F2"
                                CornerRadius="9"
                                Padding="13">
                            <StackPanel>
                                <TextBlock Text="Terminées"
                                           FontSize="12"
                                           Foreground="#718096"/>
                                <TextBlock Text="— commande(s)"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#16845B"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- MODULE PAIEMENTS -->
        <ContentControl x:Name="PaymentsContentHost"
                        Grid.Column="1"
                        Visibility="Collapsed"/>

        <!-- MODULE STATISTIQUES -->
        <ContentControl x:Name="StatisticsContentHost"
                        Grid.Column="1"
                        Visibility="Collapsed"/>

    </Grid>
</Window>
