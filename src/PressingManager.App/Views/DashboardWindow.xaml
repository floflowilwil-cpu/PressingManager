
<Window x:Class="PressingManager.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pressing Manager - Tableau de bord"
        Height="720"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border Grid.Column="0" Background="#0F2A47">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="22,30,22,35">
                    <TextBlock Text="PRESSING"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="Bold"/>

                    <TextBlock Text="MANAGER"
                               Foreground="#08A6B5"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="MENU PRINCIPAL"
                               Foreground="#91A8C2"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="22,0,0,15"/>

                    <Button x:Name="BtnDashboard"
                            Content="Tableau de bord"
                            Background="#0864D9"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="20,14"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnDashboard_Click"
                            Margin="10,0,10,8"/>

                    <Button Content="Clients"
                            Background="Transparent"
                            Foreground="#D6E1EF"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="20,14"
                            BorderThickness="0"
                            Margin="10,0,10,8"/>

                    <Button Content="Commandes"
                            Background="Transparent"
                            Foreground="#D6E1EF"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="20,14"
                            BorderThickness="0"
                            Margin="10,0,10,8"/>

                    <Button Content="Vêtements"
                            Background="Transparent"
                            Foreground="#D6E1EF"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="20,14"
                            BorderThickness="0"
                            Margin="10,0,10,8"/>

                    <Button x:Name="BtnPayments"
                            Content="Paiements"
                            Background="Transparent"
                            Foreground="#D6E1EF"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="20,14"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnPayments_Click"
                            Margin="10,0,10,8"/>

                    <Button Content="Statistiques"
                            Background="Transparent"
                            Foreground="#D6E1EF"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="20,14"
                            BorderThickness="0"
                            Margin="10,0,10,8"/>

                    <Button Content="Utilisateurs"
                            Background="Transparent"
                            Foreground="#D6E1EF"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Padding="20,14"
                            BorderThickness="0"
                            Margin="10,0,10,8"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Pressing Manager © 2026"
                           Foreground="#91A8C2"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
            </DockPanel>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <Grid x:Name="DashboardHomeContent" Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Bienvenue !"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#12365D"/>

                <TextBlock Text="Voici un aperçu de votre activité."
                           FontSize="14"
                           Foreground="#718096"
                           Margin="0,8,0,25"/>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="Vue d'ensemble"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="#12365D"
                       Margin="0,0,0,16"/>

            <!-- CARTES STATISTIQUES -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,25">

                <Border Background="White"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="CLIENTS"
                                   Foreground="#718096"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="—"
                                   Foreground="#12365D"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Total des clients"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="COMMANDES"
                                   Foreground="#718096"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="—"
                                   Foreground="#0864D9"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Total des commandes"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="EN COURS"
                                   Foreground="#718096"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="—"
                                   Foreground="#08A6B5"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Commandes en cours"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="10"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="REVENUS"
                                   Foreground="#718096"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="—"
                                   Foreground="#16845B"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Revenus enregistrés"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ACTIVITES RECENTES -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="Activités récentes"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#12365D"/>

                    <TextBlock Text="Les dernières opérations apparaîtront ici."
                               Foreground="#718096"
                               FontSize="13"
                               Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- MODULE PAIEMENTS, CAISSE ET DEPENSES (Personne 4) -->
        <ContentControl x:Name="PaymentsContentHost" Grid.Column="1" Visibility="Collapsed"/>
    </Grid>
</Window>
