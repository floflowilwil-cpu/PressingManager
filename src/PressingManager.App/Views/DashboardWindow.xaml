
<Window x:Class="PressingManager.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PressingManager.App.Localization"
        Title="{loc:T Dashboard_Title}"
        Height="720"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">

    <Window.Resources>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D6E1EF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="10,0,10,8"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#174A75"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0864D9"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarButton"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButton}">

            <Setter Property="Background" Value="#0864D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#064DA8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border Grid.Column="0" Background="#0F2A47">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="22,30,22,35">
                    <TextBlock Text="PRESSING"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="Bold"/>

                    <TextBlock Text="MANAGER"
                               Foreground="#08A6B5"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:T Nav_MainMenu}"
                                   Foreground="#91A8C2"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="22,0,0,15"/>

                        <Button x:Name="BtnDashboard"
                                Content="{loc:T Nav_Dashboard}"
                                Style="{StaticResource ActiveSidebarButton}"
                                Click="BtnDashboard_Click"/>

                        <Button Content="{loc:T Nav_Clients}"
                                Style="{StaticResource SidebarButton}"/>

                        <Button Content="{loc:T Nav_Orders}"
                                Style="{StaticResource SidebarButton}"/>

                        <Button Content="{loc:T Nav_Garments}"
                                Style="{StaticResource SidebarButton}"/>

                        <Button x:Name="BtnProcessing"
                                Content="{loc:T Nav_Processing}"
                                Style="{StaticResource SidebarButton}"
                                Click="BtnProcessing_Click"/>

                        <Button x:Name="BtnServices"
                                Content="{loc:T Nav_Services}"
                                Style="{StaticResource SidebarButton}"
                                Click="BtnServices_Click"/>

                        <Button x:Name="BtnPayments"
                                Content="{loc:T Nav_Payments}"
                                Style="{StaticResource SidebarButton}"
                                Click="BtnPayments_Click"/>

                        <Button x:Name="BtnStock"
                                Content="{loc:T Nav_Stock}"
                                Style="{StaticResource SidebarButton}"
                                Click="BtnStock_Click"/>

                        <Button x:Name="BtnStatistics"
                                Content="{loc:T Nav_Statistics}"
                                Style="{StaticResource SidebarButton}"
                                Click="BtnStatistics_Click"/>

                        <Button x:Name="BtnUsers"
                                Content="{loc:T Nav_Users}"
                                Style="{StaticResource SidebarButton}"
                                Click="BtnUsers_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Pressing Manager © 2026"
                           Foreground="#91A8C2"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
            </DockPanel>
        </Border>

        <!-- TABLEAU DE BORD -->
        <Grid x:Name="DashboardHomeContent"
              Grid.Column="1"
              Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{loc:T Dashboard_Welcome}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#12365D"/>

                <TextBlock Text="{loc:T Dashboard_Subtitle}"
                           FontSize="14"
                           Foreground="#718096"
                           Margin="0,8,0,25"/>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="{loc:T Dashboard_Overview}"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="#12365D"
                       Margin="0,0,0,16"/>

            <!-- CARTES STATISTIQUES DYNAMIQUES -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,25">

                <!-- CLIENTS -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="CLIENTS"
                                   Foreground="#718096"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="TxtCustomerCount"
                                   Text="—"
                                   Foreground="#12365D"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="Total des clients actifs"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- COMMANDES -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="COMMANDES"
                                   Foreground="#718096"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="TxtOrderCount"
                                   Text="—"
                                   Foreground="#0864D9"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="Total des commandes"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- COMMANDES EN COURS -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="EN COURS"
                                   Foreground="#718096"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="TxtOrdersInProgress"
                                   Text="—"
                                   Foreground="#08A6B5"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="Commandes en cours"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- REVENUS -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="REVENUS"
                                   Foreground="#718096"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="TxtRevenueToday"
                                   Text="—"
                                   Foreground="#16845B"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="Revenus encaissés aujourd'hui"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ACTIVITES RECENTES -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="Activités récentes"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#12365D"/>

                    <TextBlock Text="Les dernières opérations apparaîtront ici."
                               Foreground="#718096"
                               FontSize="13"
                               Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- MODULES -->
        <ContentControl x:Name="PaymentsContentHost"
                        Grid.Column="1"
                        Visibility="Collapsed"/>

        <ContentControl x:Name="StatisticsContentHost"
                        Grid.Column="1"
                        Visibility="Collapsed"/>

        <ContentControl x:Name="UsersContentHost"
                        Grid.Column="1"
                        Visibility="Collapsed"/>

        <ContentControl x:Name="ProcessingContentHost"
                        Grid.Column="1"
                        Visibility="Collapsed"/>

        <ContentControl x:Name="ServicesContentHost"
                        Grid.Column="1"
                        Visibility="Collapsed"/>

        <ContentControl x:Name="StockContentHost"
                        Grid.Column="1"
                        Visibility="Collapsed"/>

    </Grid>
</Window>
