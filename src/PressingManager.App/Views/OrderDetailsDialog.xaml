<Window x:Class="PressingManager.App.Views.OrderDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Détail de la commande"
        Width="640"
        Height="580"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- EN-TETE -->
        <DockPanel Grid.Row="0">
            <Border DockPanel.Dock="Right" Background="{Binding Background}" CornerRadius="10" Padding="12,4"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding Foreground}"
                           FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="Bold" Foreground="#12365D"/>
                <TextBlock Text="{Binding CustomerName}" FontSize="14" Foreground="#475569" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Foreground="#64748B" FontSize="12" Margin="0,10,0,16">
            <Run Text="Reçue le "/>
            <Run Text="{Binding DateText, Mode=OneWay}"/>
            <Run Text="  •  Retrait prévu : "/>
            <Run Text="{Binding ExpectedDateText, Mode=OneWay}"/>
        </TextBlock>

        <!-- ARTICLES -->
        <Border Grid.Row="2" Style="{StaticResource PmCard}">
            <DataGrid ItemsSource="{Binding Details.Items}" Style="{StaticResource PmGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Article" Binding="{Binding ItemType}" Width="1.6*"
                                        ElementStyle="{StaticResource PmCellText}"/>
                    <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="60"
                                        ElementStyle="{StaticResource PmCellText}"/>
                    <DataGridTextColumn Header="Prix unitaire" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="1.1*"
                                        ElementStyle="{StaticResource PmCellText}"/>
                    <DataGridTextColumn Header="Total ligne" Binding="{Binding LineTotal, StringFormat={}{0:N0}}" Width="1.1*"
                                        ElementStyle="{StaticResource PmCellText}"/>
                    <DataGridTextColumn Header="Observations" Binding="{Binding Observations}" Width="1.6*"
                                        ElementStyle="{StaticResource PmCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- TOTAUX -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Foreground="#64748B" FontSize="13" HorizontalAlignment="Right">
                <Run Text="Sous-total : "/>
                <Run Text="{Binding Details.Subtotal, Mode=OneWay, StringFormat={}{0:N0}}"/>
            </TextBlock>
            <TextBlock Foreground="#64748B" FontSize="13" HorizontalAlignment="Right" Margin="0,3,0,0">
                <Run Text="Remise : "/>
                <Run Text="{Binding Details.Discount, Mode=OneWay, StringFormat={}{0:N0}}"/>
                <Run Text="   Frais : "/>
                <Run Text="{Binding Details.Fees, Mode=OneWay, StringFormat={}{0:N0}}"/>
            </TextBlock>
            <TextBlock Text="{Binding AmountText, StringFormat='Total : {0}'}" Foreground="#12365D"
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
        </StackPanel>

        <Button Grid.Row="4" Content="Fermer" Style="{StaticResource PmSecondaryButton}" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </Grid>
</Window>
