<Window x:Class="PressingManager.App.Views.MobileMoneyPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PressingManager.App.Localization"
        Title="{loc:T Ussd_WindowTitle}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tete operateur (MTN Jaune ou Orange) -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#FFCC00" Padding="20,16">
            <StackPanel>
                <TextBlock x:Name="TxtOperatorTitle"
                           Text="MTN Mobile Money (*126#)"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#0F2A4A" />
                <TextBlock x:Name="TxtOrderSummary"
                           Text="Commande"
                           FontSize="12"
                           Foreground="#0F2A4A"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Corps -->
        <Border Grid.Row="1" Background="White" Margin="18" Padding="18" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:T Ussd_PhoneLabel}" FontSize="11" Foreground="#64748B" />
                            <TextBlock x:Name="TxtPhoneNumber" Text="+237 6..." FontSize="15" FontWeight="Bold" Foreground="#0F2A4A" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{loc:T Ussd_AmountLabel}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                            <TextBlock x:Name="TxtAmount" Text="0 FCFA" FontSize="16" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Panneau Simulation -->
                <StackPanel x:Name="SimulationPanel" Visibility="Collapsed">
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="{loc:T Ussd_SimBanner}" FontSize="12" Foreground="#92400E" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{loc:T Ussd_PinPrompt}" Style="{StaticResource FieldLabel}" Margin="0,2,0,4" />
                    <PasswordBox x:Name="PinBox" MaxLength="6" />
                </StackPanel>

                <!-- Panneau Campay Live -->
                <StackPanel x:Name="LivePanel" Visibility="Collapsed">
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtLiveBanner" Text="{loc:T Ussd_LiveWaiting}" FontSize="12.5" Foreground="#065F46" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="TxtStatusMessage"
                           Margin="0,10,0,0"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="#C0392B"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,18">
            <Button x:Name="BtnCancel"
                    Content="{loc:T Ussd_CancelBtn}"
                    Style="{StaticResource BtnLight}"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click" />

            <Button x:Name="BtnConfirm"
                    Content="{loc:T Ussd_ConfirmBtn}"
                    Background="#10B981"
                    Style="{StaticResource BtnPrimary}"
                    Click="ConfirmButton_Click" />

            <Button x:Name="BtnRetry"
                    Content="{loc:T Ussd_RetryBtn}"
                    Style="{StaticResource BtnPrimary}"
                    Visibility="Collapsed"
                    Click="RetryButton_Click" />
        </StackPanel>
    </Grid>
</Window>
