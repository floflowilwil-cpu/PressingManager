<Window x:Class="PressingManager.App.Views.NewOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle commande"
        Width="820"
        Height="760"
        MinWidth="720"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nouvelle commande" FontSize="22" FontWeight="Bold" Foreground="#12365D"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <StackPanel Margin="0,0,12,0">

                <!-- 1. CLIENT -->
                <TextBlock Text="1. Client *" Style="{StaticResource PmLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Tag="Rechercher un client..."
                             Style="{StaticResource PmSearchBox}"
                             Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox Grid.Column="2" ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              FontSize="13" Padding="10,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CustomerNumber}" Foreground="#64748B" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Phone}" Foreground="#64748B"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- 2. ARTICLES -->
                <TextBlock Text="2. Articles *" Style="{StaticResource PmLabel}" Margin="0,22,0,4"/>

                <Border Style="{StaticResource PmCard}" Background="#F8FAFC" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Service" Style="{StaticResource PmLabel}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ServiceOptions}"
                                          SelectedItem="{Binding SelectedService}"
                                          DisplayMemberPath="Label" FontSize="13" Padding="10,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Type d'article" Style="{StaticResource PmLabel}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource PmInput}" MaxLength="100"
                                         Text="{Binding NewItemType, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Qté" Style="{StaticResource PmLabel}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource PmInput}"
                                         Text="{Binding NewQuantityText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Prix unitaire" Style="{StaticResource PmLabel}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource PmInput}"
                                         Text="{Binding NewUnitPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Observations (tache, article fragile...)" Style="{StaticResource PmLabel}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource PmInput}" MaxLength="500"
                                         Text="{Binding NewObservation, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="Ajouter l'article" VerticalAlignment="Bottom"
                                    Style="{StaticResource PmPrimaryButton}"
                                    Command="{Binding AddLineCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- LIGNES DE LA COMMANDE -->
                <Border Style="{StaticResource PmCard}" Margin="0,12,0,0">
                    <Grid MinHeight="90">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="13" Foreground="#1E293B">
                                                    <Run Text="{Binding Quantity, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text=" ×  "/>
                                                    <Run Text="{Binding ItemType, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ServiceName}" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Observations}" FontSize="11" Foreground="#94A3B8"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LineTotalText}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#12365D" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding UnitPriceText}" FontSize="11" Foreground="#94A3B8"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="&#xE74D;" ToolTip="Retirer cet article"
                                                    Style="{StaticResource PmIconButton}" Foreground="#DC2626"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Aucun article ajouté pour le moment."
                                   Foreground="#94A3B8" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoLines, Converter={StaticResource PmBoolToVisibility}}"/>
                    </Grid>
                </Border>

                <!-- 3. DETAILS -->
                <TextBlock Text="3. Détails" Style="{StaticResource PmLabel}" Margin="0,22,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date de retrait prévue" Style="{StaticResource PmLabel}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding ExpectedDate}" FontSize="13" Padding="6,7"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Remise" Style="{StaticResource PmLabel}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource PmInput}"
                                 Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Frais" Style="{StaticResource PmLabel}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource PmInput}"
                                 Text="{Binding FeesText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Notes" Style="{StaticResource PmLabel}"/>
                <TextBox Style="{StaticResource PmInput}" MaxLength="1000" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- TOTAUX + ACTIONS -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Foreground="#64748B" FontSize="12">
                        <Run Text="Sous-total : "/>
                        <Run Text="{Binding SubtotalText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="#12365D" FontSize="18" FontWeight="Bold" Margin="0,2,0,0">
                        <Run Text="Total : "/>
                        <Run Text="{Binding TotalText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Annuler" Style="{StaticResource PmSecondaryButton}" IsCancel="True" Margin="0,0,10,0"/>
                    <Button Content="Créer la commande" Style="{StaticResource PmPrimaryButton}"
                            Click="BtnCreate_Click" IsEnabled="{Binding IsNotBusy}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
