<UserControl x:Class="PressingManager.App.Views.OrderProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PressingManager.App.Localization"
             Background="#F3F6FB">
    <UserControl.Resources>
        <!-- Pressing Manager / Personne 3 : theme visuel renforce -->
        <SolidColorBrush x:Key="UiNavy" Color="#142B45" />
        <SolidColorBrush x:Key="UiTeal" Color="#0F9F9A" />
        <SolidColorBrush x:Key="UiLine" Color="#DCE6EF" />
        <SolidColorBrush x:Key="UiMuted" Color="#64748B" />


        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,5" />
            <Setter Property="Foreground" Value="#718096" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style x:Key="LightButton" TargetType="Button" BasedOn="{StaticResource BtnLight}">
            <Setter Property="Margin" Value="0" />
        </Style>


        <!-- Commande en retard : rouge ; prete a recuperer : vert -->
        <Style x:Key="OrderRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadyForPickup}" Value="True">
                    <Setter Property="Foreground" Value="#16845B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Foreground" Value="#C0392B" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26">
        <!-- ACCES REFUSE (role sans la permission ViewOrders) -->
        <Border Background="White" CornerRadius="10" Padding="30" VerticalAlignment="Top"
                Visibility="{Binding IsAccessDenied, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:T Proc_AccessDenied}" FontSize="16" Foreground="#C0392B" TextWrapping="Wrap" />
        </Border>

        <Grid Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#0F2A4A" Margin="0,0,12,0">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#14B8A6" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M12,3 C7,3 3,7 3,12 C3,17 7,21 12,21 C17,21 21,17 21,12 C21,7 17,3 12,3 Z M12,7 L12,12 L15.5,14" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Proc_Title}" FontSize="25" FontWeight="Bold" Foreground="#142B45" />
                        <TextBlock Text="{loc:T Proc_Subtitle}" FontSize="12" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{loc:T Ord_NewOrderBtn}"
                        Style="{StaticResource BtnPrimary}"
                        VerticalAlignment="Center"
                        Visibility="{Binding CanCreateOrder, Converter={StaticResource BoolToVisibility}}"
                        Click="BtnNewOrder_Click" />
            </Grid>

            <!-- GAUCHE : file de traitement -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E8EEF5" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{loc:T Common_Refresh}" Command="{Binding LoadCommand}"
                                Style="{StaticResource LightButton}" Margin="12,0,0,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SummaryText}" Foreground="#64748B"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <ComboBox ItemsSource="{Binding Filters}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedFilter}" Width="210" />
                            <TextBox Width="190" Margin="10,0,0,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:T Ord_SearchHint}" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}"
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                              RowStyle="{StaticResource OrderRowStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                              BorderThickness="0" Background="White" RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T Ord_ColId}" Binding="{Binding OrderIdText}" Width="58" />
                            <DataGridTextColumn Header="{loc:T Proc_ColNumber}" Binding="{Binding OrderNumber}" Width="160" />
                            <DataGridTextColumn Header="{loc:T Proc_ColCustomer}" Binding="{Binding CustomerName}" Width="*" />
                            <DataGridTextColumn Header="{loc:T Ord_ColTotal}" Binding="{Binding TotalText}" Width="105" />
                            <DataGridTextColumn Header="{loc:T Proc_ColStatus}" Binding="{Binding StatusText}" Width="140" />
                            <DataGridTextColumn Header="{loc:T Proc_ColExpected}" Binding="{Binding ExpectedText}" Width="95" />
                            <DataGridTextColumn Header="{loc:T Proc_ColItems}" Binding="{Binding ItemCount}" Width="65" />
                            <DataGridTextColumn Header="{loc:T Proc_ColFlag}" Binding="{Binding FlagText}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- DROITE : resume financier, articles, changement de statut et historique -->
            <Border Grid.Row="1" Grid.Column="1" Padding="18" Background="White" BorderBrush="#E8EEF5" BorderThickness="1" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:T Proc_Selected}" FontWeight="Bold" Foreground="#0F8F91" />

                        <TextBlock Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold" Foreground="#12365D"
                                   Visibility="{Binding IsOrderSelected, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="{Binding SelectedOrder.OrderIdText, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding SelectedOrder.OrderNumber, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding SelectedOrder.StatusText, Mode=OneWay}" />
                        </TextBlock>

                        <!-- Encadre client / solde / articles / bouton Encaisser -->
                        <Border Background="#F8FAFC" BorderBrush="#DCE6EF" BorderThickness="1" CornerRadius="8"
                                Padding="12" Margin="0,10,0,0"
                                Visibility="{Binding IsOrderSelected, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedOrder.CustomerName}" FontWeight="Bold"
                                           Foreground="#12365D" FontSize="13" />
                                <TextBlock Text="{Binding SelectedOrderBillingText}" FontWeight="SemiBold"
                                           Foreground="#065F46" FontSize="12" Margin="0,3,0,8" TextWrapping="Wrap" />

                                <TextBlock Text="{loc:T Ord_ItemsTitle}" FontSize="11" FontWeight="Bold"
                                           Foreground="#64748B" Margin="0,2,0,4" />

                                <ItemsControl ItemsSource="{Binding SelectedOrderItems}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#24364B" />
                                                <TextBlock Text="{Binding LineTotalText}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#12365D" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="{loc:T Ord_PayBtn}"
                                        Command="{Binding PaySelectedOrderCommand}"
                                        IsEnabled="{Binding CanPaySelectedOrder}"
                                        Background="#10B981"
                                        Style="{StaticResource BtnPrimary}"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding CanPayOrder, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- Barre visuelle de progression des statuts -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding IsOrderSelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:T Ord_ProgressTitle}" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding StatusSteps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" BorderThickness="1" Padding="9,4" Margin="0,0,6,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReached}" Value="True">
                                                            <Setter Property="Background" Value="#ECFDF5" />
                                                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="#0F2A4A" />
                                                            <Setter Property="BorderBrush" Value="#0F2A4A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReached}" Value="True">
                                                                <Setter Property="Foreground" Value="#065F46" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel IsEnabled="{Binding IsOrderSelected}"
                                    Visibility="{Binding CanChangeStatus, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:T Proc_NewStatus}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding NextStatuses}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedNextStatus}" />

                            <TextBlock Text="{loc:T Proc_NoTransition}" Foreground="#64748B" TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasNoTransition, Converter={StaticResource BoolToVisibility}}" />

                            <CheckBox Content="{loc:T Proc_Correction}" IsChecked="{Binding IsCorrectionMode, Mode=TwoWay}"
                                      Margin="0,10,0,0" Foreground="#12365D"
                                      Visibility="{Binding CanCorrect, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{loc:T Proc_Comment}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="False" />

                            <Button Content="{loc:T Proc_Apply}" Command="{Binding ApplyStatusCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>

                        <Separator Margin="0,20" />

                        <TextBlock Text="{loc:T Proc_History}" FontWeight="Bold" Foreground="#0F8F91" />

                        <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" BorderThickness="0" Background="White" RowHeight="38"
                                  Height="230" Margin="0,8,0,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Proc_HistDate}"
                                                    Binding="{Binding ChangedAtLocal, StringFormat='dd/MM HH:mm'}" Width="90" />
                                <DataGridTextColumn Header="{loc:T Proc_HistFrom}" Binding="{Binding FromText}" Width="110" />
                                <DataGridTextColumn Header="{loc:T Proc_HistTo}" Binding="{Binding ToText}" Width="110" />
                                <DataGridTextColumn Header="{loc:T Proc_HistBy}" Binding="{Binding UserText}" Width="120" />
                                <DataGridTextColumn Header="{loc:T Proc_HistCorrection}" Binding="{Binding CorrectionText}" Width="90" />
                                <DataGridTextColumn Header="{loc:T Proc_HistComment}" Binding="{Binding Comment}" Width="200" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Message}" Margin="0,12,0,0"
                       TextWrapping="Wrap" FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#1E8449" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#C0392B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
