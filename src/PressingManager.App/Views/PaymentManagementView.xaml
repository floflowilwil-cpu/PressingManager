<UserControl x:Class="PressingManager.App.Views.PaymentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:PressingManager.Core.Enums;assembly=PressingManager.Core"
             xmlns:loc="clr-namespace:PressingManager.App.Localization"
             Background="#F3F6FB">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="#0F2A4A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#0F2A4A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MethodCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="10,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tete + Badge etat de caisse -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="10" Background="#0F2A4A" Margin="0,0,12,0">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#14B8A6" StrokeThickness="2" StrokeLineJoin="Round"
                                  Data="M3,6 L21,6 L21,18 L3,18 Z M3,10 L21,10 M7,14 L11,14" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Pay_Title}" FontSize="22" FontWeight="Bold" Foreground="#0F2A4A" />
                    <TextBlock Text="{loc:T Pay_Subtitle}" FontSize="12" Foreground="#64748B" />
                </StackPanel>
            </StackPanel>

            <!-- Badge Caisse ouverte / fermee -->
            <Border Grid.Column="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FEE2E2" />
                        <Setter Property="BorderBrush" Value="#FECACA" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCashSessionOpen}" Value="True">
                                <Setter Property="Background" Value="#DCFCE7" />
                                <Setter Property="BorderBrush" Value="#A7F3D0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding CashStatusLabel}" FontWeight="SemiBold" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#991B1B" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCashSessionOpen}" Value="True">
                                    <Setter Property="Foreground" Value="#065F46" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <!-- Colonne gauche : Encaissement + Historique paiements -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>

                <!-- Carte 1 : Commande & Solde -->
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:T Pay_Section1Title}" FontWeight="Bold" Foreground="#14B8A6" FontSize="14" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding OrderIdText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:T Pay_OrderLookupTooltip}"
                                     Padding="8" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Content="{loc:T Pay_LoadOrderBtn}" Command="{Binding LoadOrderCommand}"
                                    Style="{StaticResource RoundedButton}" />
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,12,0,0"
                                Visibility="{Binding IsOrderLoaded, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:T Pay_OrderNumber}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold" Foreground="#0F2A4A" FontSize="14" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:T Pay_Customer}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding CustomerName}" FontWeight="Bold" Foreground="#0F2A4A" FontSize="14" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:T Pay_TotalBilled}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding OrderTotal, StringFormat='{}{0:N2}'}" FontWeight="Bold" Foreground="#0F2A4A" FontSize="14" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{loc:T Pay_RemainingBalance}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding RemainingBalance, StringFormat='{}{0:N2}'}" FontWeight="Bold" Foreground="#10B981" FontSize="16" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Carte 2 : Choix visuel du moyen de paiement + Validation -->
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:T Pay_Section2Title}" FontWeight="Bold" Foreground="#14B8A6" FontSize="14" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Carte Especes -->
                            <Button Grid.Column="0" Command="{Binding SelectMethodCommand}" CommandParameter="{x:Static enums:PaymentMethod.Cash}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MethodCardButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                                <Setter Property="BorderBrush" Value="#10B981" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#DCFCE7" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Viewbox Width="20" Height="20">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="#10B981" StrokeThickness="2" StrokeLineJoin="Round"
                                                      Data="M2,7 L22,7 L22,17 L2,17 Z M12,10 C13.1,10 14,10.9 14,12 C14,13.1 13.1,14 12,14 C10.9,14 10,13.1 10,12 C10,10.9 10.9,10 12,10 Z" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{loc:T Pay_CardCash}" FontWeight="Bold" FontSize="12" Foreground="#0F2A4A" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Carte MTN Mobile Money -->
                            <Button Grid.Column="1" Command="{Binding SelectMethodCommand}" CommandParameter="{x:Static enums:PaymentMethod.MtnMobileMoney}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MethodCardButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMtnSelected}" Value="True">
                                                <Setter Property="Background" Value="#FFFBEB" />
                                                <Setter Property="BorderBrush" Value="#F59E0B" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#FFCC00" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="MTN" FontWeight="ExtraBold" FontSize="11" Foreground="#0F2A4A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{loc:T Pay_CardMtn}" FontWeight="Bold" FontSize="12" Foreground="#0F2A4A" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Carte Orange Money -->
                            <Button Grid.Column="2" Command="{Binding SelectMethodCommand}" CommandParameter="{x:Static enums:PaymentMethod.OrangeMoney}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MethodCardButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOrangeSelected}" Value="True">
                                                <Setter Property="Background" Value="#FFF7ED" />
                                                <Setter Property="BorderBrush" Value="#EA580C" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#FF7900" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="OM" FontWeight="ExtraBold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{loc:T Pay_CardOrange}" FontWeight="Bold" FontSize="12" Foreground="#0F2A4A" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Carte Autre -->
                            <Button Grid.Column="3" Margin="0" Command="{Binding SelectMethodCommand}" CommandParameter="{x:Static enums:PaymentMethod.Other}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MethodCardButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOtherSelected}" Value="True">
                                                <Setter Property="Background" Value="#EFF6FF" />
                                                <Setter Property="BorderBrush" Value="#0F2A4A" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#E0F2FE" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Viewbox Width="18" Height="18">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="#0F2A4A" StrokeThickness="2" StrokeLineJoin="Round"
                                                      Data="M2,5 L22,5 L22,19 L2,19 Z M2,10 L22,10 M6,15 L10,15" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{loc:T Pay_CardOther}" FontWeight="Bold" FontSize="12" Foreground="#0F2A4A" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:T Pay_AmountToCollect}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Visibility="{Binding IsMobileMoneySelected, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:T Pay_MobileMoneyRef}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TransactionReference, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding RegisterPaymentCommand}" Background="#10B981" Style="{StaticResource RoundedButton}" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M4,12.5 L9.5,18 L20,6.5" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{loc:T Pay_ValidateAndReceiptBtn}" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Carte confirmation dernier recu genere -->
                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,14"
                        Visibility="{Binding HasLatestReceipt, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="40" Height="40" CornerRadius="20" Background="#10B981" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M4.5,12.5 L9.5,17.5 L19.5,6.5" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Pay_LatestReceiptReady}" FontWeight="Bold" Foreground="#065F46" FontSize="13" />
                            <TextBlock Text="{Binding LatestReceiptSummary}" Foreground="#047857" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="{loc:T Pay_ViewPrintReceiptBtn}" Command="{Binding OpenLatestReceiptCommand}"
                                Background="#0F2A4A" Style="{StaticResource RoundedButton}" />
                    </Grid>
                </Border>

                <!-- Carte 3 : Historique des paiements de la commande -->
                <Border Background="White" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{loc:T Pay_Section3Title}" FontWeight="Bold" Foreground="#14B8A6" FontSize="14" Margin="0,0,0,10" />

                        <DataGrid ItemsSource="{Binding OrderPayments}" SelectedItem="{Binding SelectedPayment, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                                  MinHeight="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Pay_ColId}" Binding="{Binding Id}" Width="50" />
                                <DataGridTextColumn Header="{loc:T Pay_ColDate}" Binding="{Binding PaidAtLocal, StringFormat='dd/MM/yyyy HH:mm'}" Width="130" />
                                <DataGridTextColumn Header="{loc:T Pay_ColAmount}" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="100" />
                                <DataGridTextColumn Header="{loc:T Pay_ColMethod}" Binding="{Binding MethodLabel}" Width="135" />
                                <DataGridTextColumn Header="{loc:T Pay_ColReference}" Binding="{Binding Reference}" Width="120" />
                                <DataGridTextColumn Header="{loc:T Pay_ColStatus}" Binding="{Binding StatusLabel}" Width="95" />
                                <DataGridTextColumn Header="{loc:T Pay_ColReason}" Binding="{Binding CancelReason}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8" Margin="0,0,8,0" ToolTip="{loc:T Pay_ReasonTooltip}" />
                            <Button Grid.Column="1" Content="{loc:T Pay_ReceiptBtn}" Command="{Binding OpenSelectedPaymentReceiptCommand}"
                                    Background="#14B8A6" Style="{StaticResource RoundedButton}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="{loc:T Pay_CancelBtn}" Command="{Binding CancelSelectedPaymentCommand}"
                                    Background="#D97706" Style="{StaticResource RoundedButton}" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Content="{loc:T Pay_RefundBtn}" Command="{Binding RefundSelectedPaymentCommand}"
                                    Background="#C0392B" Style="{StaticResource RoundedButton}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Colonne droite : Caisse et Depenses -->
        <Border Grid.Row="1" Grid.Column="1" Padding="18" Background="White" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:T Pay_CashSectionTitle}" FontWeight="Bold" Foreground="#14B8A6" FontSize="14" />

                    <TextBlock Text="{loc:T Pay_OpeningFloat}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding OpeningAmountText, UpdateSourceTrigger=PropertyChanged}" Padding="7" />
                    <Button Content="{loc:T Pay_OpenCashBtn}" Command="{Binding OpenCashSessionCommand}"
                            Background="#10B981" Style="{StaticResource RoundedButton}" Margin="0,10,0,0" />

                    <TextBlock Text="{loc:T Pay_CountedCash}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <TextBox Text="{Binding CountedAmountText, UpdateSourceTrigger=PropertyChanged}" Padding="7" />
                    <TextBlock Text="{loc:T Pay_CloseComment}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding CloseComment, UpdateSourceTrigger=PropertyChanged}" Padding="7" />
                    <Button Content="{loc:T Pay_CloseCashBtn}" Command="{Binding CloseCashSessionCommand}"
                            Style="{StaticResource RoundedButton}" Margin="0,10,0,0" />

                    <Separator Margin="0,18" />

                    <TextBlock Text="{loc:T Pay_ExpenseSectionTitle}" FontWeight="Bold" Foreground="#14B8A6" FontSize="14" />

                    <TextBlock Text="{loc:T Pay_ExpenseCategory}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ExpenseCategory, UpdateSourceTrigger=PropertyChanged}" Padding="7" />

                    <TextBlock Text="{loc:T Pay_ExpenseAmount}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ExpenseAmountText, UpdateSourceTrigger=PropertyChanged}" Padding="7" />

                    <TextBlock Text="{loc:T Pay_ExpenseMethod}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ExpenseMethods}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding ExpenseMethod}" />

                    <TextBlock Text="{loc:T Pay_ExpenseComment}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ExpenseComment, UpdateSourceTrigger=PropertyChanged}" Padding="7" />

                    <Button Content="{loc:T Pay_SaveExpenseBtn}" Command="{Binding CreateExpenseCommand}"
                            Style="{StaticResource RoundedButton}" Margin="0,10,0,12" />

                    <TextBlock Text="{loc:T Pay_RecentExpenses}" FontWeight="SemiBold" Foreground="#0F2A4A" FontSize="12" Margin="0,4,0,6" />
                    <ItemsControl ItemsSource="{Binding RecentExpenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="#0F2A4A" FontSize="12" />
                                        <TextBlock Text="{Binding Amount, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#C0392B" FontSize="12" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Barre de feedback en bas -->
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Message}" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#1E8449" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="#C0392B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
